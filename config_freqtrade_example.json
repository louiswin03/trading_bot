{
    "trading_mode": "futures",
    "margin_mode": "isolated",

    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.98,

    "dry_run": true,
    "dry_run_wallet": 10000,

    "timeframe": "4h",

    "max_open_trades": 1,

    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
