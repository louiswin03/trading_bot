# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Binance API (for live trading)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Alternative.me API (Fear & Greed Index) - Free, no key needed
# https://api.alternative.me/fng/

# CryptoPanic API (Crypto News)
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here
# Get free key at: https://cryptopanic.com/developers/api/

# Glassnode API (On-chain data)
GLASSNODE_API_KEY=your_glassnode_api_key_here
# Get key at: https://studio.glassnode.com/settings/api

# NewsAPI (General news)
NEWSAPI_KEY=your_newsapi_key_here
# Get free key at: https://newsapi.org/

# Trading Configuration
DEFAULT_PAIR=BTCUSDT
DEFAULT_INTERVAL=15m
RISK_PERCENTAGE=1.0
MAX_POSITION_SIZE=100

# Database
DB_PATH=data/trading_bot.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
